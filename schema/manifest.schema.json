{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/glotyuids/engineering-skills/main/schema/manifest.schema.json",
  "title": "engineering-skills manifest",
  "description": "Machine-readable pack index. The source of truth for the README catalog, install.sh, check-drift.sh, the plugin marketplace, and agent-driven installs.",
  "type": "object",
  "required": ["name", "repo", "version", "packs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "repo": { "type": "string", "description": "owner/name on GitHub" },
    "version": { "type": "string" },
    "license": { "type": "string" },
    "description": { "type": "string" },
    "toolPaths": {
      "type": "object",
      "description": "Where each tool reads skills and agents from. null means the tool has no such concept.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "skills": { "type": ["string", "null"], "description": "project-scope skills directory" },
          "agents": { "type": ["string", "null"], "description": "project-scope agents directory" },
          "userSkills": { "type": ["string", "null"] },
          "userAgents": { "type": ["string", "null"] },
          "note": { "type": "string" }
        }
      }
    },
    "neverPublish": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit deny list. Paths that must never be included in this repository or any publication glob, regardless of .gitignore — e.g. material identifying a real person."
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "skills", "skillPath"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "skills": { "type": "array", "items": { "type": "string" } },
          "skillPath": { "type": "string", "description": "directory holding this pack's skills, relative to the repo root" },
          "agents": { "type": "array", "items": { "type": "string" } },
          "agentPath": { "type": "string" },
          "capabilities": {
            "type": "array",
            "items": { "enum": ["MANAGED_K8S", "REGISTRY", "SECRET_MANAGER", "MANAGED_PG", "CACHE", "TFSTATE_BACKEND", "LB", "IAM"] },
            "description": "Capabilities this pack's skills reference but do not resolve. A cloud pack must provide them."
          },
          "provides": {
            "type": "array",
            "items": { "enum": ["MANAGED_K8S", "REGISTRY", "SECRET_MANAGER", "MANAGED_PG", "CACHE", "TFSTATE_BACKEND", "LB", "IAM"] },
            "description": "Capabilities this (cloud) pack resolves to concrete services."
          },
          "companions": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Packs that pair well. Suggestions only — every pack must work with its companions absent."
          }
        }
      }
    }
  }
}
