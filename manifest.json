{
  "$schema": "./schema/manifest.schema.json",
  "name": "engineering-skills",
  "repo": "glotyuids/engineering-skills",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Tool-agnostic engineering skills and guidelines for AI coding agents.",
  "toolPaths": {
    "claude": {
      "skills": ".claude/skills",
      "agents": ".claude/agents",
      "userSkills": "~/.claude/skills",
      "userAgents": "~/.claude/agents"
    },
    "codex": {
      "skills": ".agents/skills",
      "agents": null,
      "userSkills": "~/.agents/skills",
      "userAgents": null
    },
    "cursor": {
      "skills": ".agents/skills",
      "agents": ".cursor/agents",
      "userSkills": "~/.cursor/skills",
      "userAgents": "~/.cursor/agents"
    },
    "copilot": {
      "skills": ".agents/skills",
      "agents": null,
      "userSkills": "~/.copilot/skills",
      "userAgents": null
    },
    "gemini": {
      "skills": ".agents/skills",
      "agents": null,
      "userSkills": "~/.agents/skills",
      "userAgents": null
    },
    "lovable": {
      "skills": null,
      "agents": null,
      "note": "Upload the pack zip in workspace Settings > Skills; root AGENTS.md is read from the connected repo."
    }
  },
  "neverPublish": [
    "Any directory whose content describes an identifiable individual (a personal dossier, CV, or profile-backed skill).",
    "Agent tool state and approval-rule files — they capture command payloads and account identifiers.",
    "**/*-workspace/**  — eval run transcripts.",
    "Local analysis notes about private repositories; keep them untracked."
  ],
  "packs": [
    {
      "id": "core",
      "title": "Core",
      "description": "Project bootstrap plus the language-neutral planning and review agents.",
      "skills": [
        "bootstrap-project"
      ],
      "skillPath": "skills/meta",
      "agents": [
        "architect",
        "planner",
        "code-explorer",
        "code-reviewer",
        "security-reviewer"
      ],
      "agentPath": "agents/core",
      "companions": []
    },
    {
      "id": "process",
      "title": "Process",
      "description": "Git workflow, documentation standards, plan review, integration testing, incident response, de-slopping, a file-based task board, and application-security practice.",
      "skills": [
        "git-workflow",
        "documentation-standards",
        "deslop",
        "review-plan",
        "integration-testing",
        "incident-response",
        "kanban-md",
        "security-guidelines"
      ],
      "skillPath": "skills/process",
      "agents": [],
      "companions": [
        "core"
      ]
    },
    {
      "id": "infra",
      "title": "Infrastructure (vendor-neutral)",
      "description": "Build/deploy pipeline, Terraform, Ansible, Kubernetes/Helm, Makefiles and secrets — written against capabilities, not a cloud provider.",
      "skills": [
        "cicd-build-deploy",
        "terraform-conventions",
        "ansible-deploy",
        "kubernetes-helm",
        "makefile-conventions",
        "secrets-management"
      ],
      "skillPath": "skills/infra",
      "agents": [],
      "capabilities": [
        "MANAGED_K8S",
        "REGISTRY",
        "SECRET_MANAGER",
        "MANAGED_PG",
        "TFSTATE_BACKEND",
        "LB",
        "IAM"
      ],
      "companions": [
        "cloud-yandex"
      ]
    },
    {
      "id": "cloud-yandex",
      "title": "Yandex Cloud",
      "description": "Capability-to-service mapping and production traps for Yandex Cloud.",
      "skills": [
        "yandex-cloud"
      ],
      "skillPath": "skills/cloud",
      "agents": [],
      "provides": [
        "MANAGED_K8S",
        "REGISTRY",
        "SECRET_MANAGER",
        "MANAGED_PG",
        "TFSTATE_BACKEND",
        "LB",
        "IAM"
      ],
      "companions": [
        "infra"
      ]
    },
    {
      "id": "go",
      "title": "Go microservices",
      "description": "Clean-architecture Go conventions, service scaffolding, API/event contracts and observability.",
      "skills": [
        "go-conventions",
        "new-microservice",
        "api-and-events",
        "observability-and-quality"
      ],
      "skillPath": "skills/go",
      "agents": [
        "go-reviewer",
        "go-build-resolver",
        "silent-failure-hunter"
      ],
      "agentPath": "agents/go",
      "companions": [
        "infra",
        "database"
      ]
    },
    {
      "id": "database",
      "title": "Database",
      "description": "PostgreSQL patterns and migration discipline.",
      "skills": [
        "postgres-patterns",
        "database-migrations"
      ],
      "skillPath": "skills/database",
      "agents": [
        "database-reviewer"
      ],
      "agentPath": "agents/database",
      "companions": []
    },
    {
      "id": "frontend",
      "title": "Frontend",
      "description": "React/React Native conventions, design-system authoring, internationalisation and Playwright end-to-end testing.",
      "skills": [
        "react-conventions",
        "design-system-authoring",
        "i18n-conventions",
        "ui-test-playwright"
      ],
      "skillPath": "skills/frontend",
      "agents": [],
      "companions": []
    },
    {
      "id": "llm",
      "title": "LLM engineering",
      "description": "Safety rules for LLM pipelines, MCP server authoring and skill authoring.",
      "skills": [
        "llm-pipeline-rules",
        "mcp-server-authoring",
        "skill-authoring"
      ],
      "skillPath": "skills/llm",
      "agents": [],
      "companions": []
    },
    {
      "id": "writing",
      "title": "Writing",
      "description": "Purposeful product writing, honesty gates for generative writing products, and cover-letter craft/review.",
      "skills": [
        "purposeful-text-writing",
        "writing-honesty-gates",
        "cover-letter-craft",
        "review-cover-letter"
      ],
      "skillPath": "skills/writing",
      "agents": [],
      "companions": [
        "lang-ru"
