    {
      "id": "lang-ru",
      "title": "Russian market (lang-ru)",
      "description": "Russian-language product engineering written in English: plurals and gendered forms, RU/EN tone transfer, RU job-application norms, bilingual product architecture.",
      "skills": [
        "ru-ui-strings",
        "ru-en-tone-transfer",
        "ru-market-job-application-norms",
        "bilingual-product-architecture"
      ],
      "skillPath": "skills/lang-ru",
      "agents": [],
      "companions": [
        "frontend",
        "writing"
      ]
    }
  ]
}
